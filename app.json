{
  "expo": {
    "name": "Luchot",
    "slug": "dual-calendar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "luchot",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.luchot"
    },
    "android": {
      "package": "app.luchot",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E4BA2"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_EXACT_ALARM"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "content", "mimeType": "text/calendar" },
            { "scheme": "file", "mimeType": "text/calendar" }
          ]
        }
      ]
    },
    "updates": {
      "url": "https://u.expo.dev/73dcf406-9cd1-4bec-a83c-cde688268f4a",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Luchot uses your location to calculate zmanim (halachic times)."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/luchot_reminder.wav"
          ]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "73dcf406-9cd1-4bec-a83c-cde688268f4a"
      }
    },
    "owner": "shlomolif"
  }
}
