{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "expo-modules-core": ["node_modules/expo/node_modules/expo-modules-core"],
      "expo-modules-core/*": ["node_modules/expo/node_modules/expo-modules-core/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
